[Unit]
Description=RivetPanel backup
After=rivetpanel.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/rivetpanel/rivetpanel.env
# Database snapshot + bot files. Encryption keys are NOT included: back them up
# separately (see docs/backup.md). Keeps the newest 14 backups.
ExecStart=/bin/sh -c 'umask 077; exec /usr/local/bin/rivetpanel backup /var/backups/rivetpanel/$(date +%%Y%%m%%d-%%H%%M%%S)'
ExecStartPost=/bin/sh -c 'ls -1dt /var/backups/rivetpanel/*/ | tail -n +15 | xargs -r rm -rf'
User=root
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/rivetpanel /var/lib/rivetpanel
ReadOnlyPaths=/etc/rivetpanel
StateDirectory=
