# Most variables below can also be changed from Administration -> Environment;
# a value saved there wins over this file after the next restart. Remove saved
# values from the host with: rivetpanel env reset
# Copy to /etc/rivetpanel/rivetpanel.env (mode 0640). Contains no secrets until you
# add OAuth client secrets below.
# The listen address is loopback by default; put a TLS reverse proxy in front.
RIVET_LISTEN=127.0.0.1:8080
RIVET_DB_PATH=/var/lib/rivetpanel/rivetpanel.db
RIVET_DATA_ROOT=/var/lib/rivetpanel/bots
# Encryption keys live outside the database. Create with: rivetpanel keygen
RIVET_KEY_DIR=/etc/rivetpanel/keys
RIVET_ACTIVE_KEY_ID=k1
RIVET_DOCKER_HOST=unix:///var/run/docker.sock
# Bot processes run as this uid:gid inside containers. Workspaces are chowned to it.
RIVET_CONTAINER_USER=65532:65532
# Only if the panel cannot run as root or with CAP_CHOWN: let bot containers
# share the panel's own uid (weaker isolation, see docs/deployment.md).
# RIVET_ALLOW_SHARED_UID=1
# Outbound-only networking is enforced by your firewall, see docs/isolation.md.
RIVET_CONTAINER_NETWORK=bridge
# Per-server maximums default to each node's own memory and CPU count.
# Set these only to impose a lower panel-wide cap.
# RIVET_MAX_BOT_MEMORY_BYTES=2147483648
# RIVET_MAX_BOT_NANO_CPUS=2000000000
RIVET_MAX_UPLOAD_BYTES=33554432

# --- Remote execution nodes (preview; see docs/agents.md) -------------------
# RIVET_MODULES=agents=preview,game_servers=preview
# Raw mutually authenticated TLS listener. Open it to nodes; do not proxy it
# through an HTTP reverse proxy.
# RIVET_AGENT_LISTEN=:8444
# RIVET_AGENT_ADDRESS=panel.example.com:8444
# RIVET_AGENT_HOSTS=panel.example.com

# --- Sign-in with GitHub / Discord (optional; see docs/oauth.md) -------------
# The public origin users type in the browser: scheme + host, no path, no
# trailing slash. OAuth callback URLs are derived from it:
#   <PUBLIC_URL>/api/v1/auth/github/callback
#   <PUBLIC_URL>/api/v1/auth/discord/callback
# RIVET_PUBLIC_URL=https://panel.example.com
# A provider is enabled only when both its id and secret are set. Client
# secrets are credentials: keep this file owned by root, mode 0640
# (deploy/install.sh installs it that way).
# RIVET_GITHUB_CLIENT_ID=
# RIVET_GITHUB_CLIENT_SECRET=
# RIVET_DISCORD_CLIENT_ID=
# RIVET_DISCORD_CLIENT_SECRET=
# 1 = an unknown GitHub/Discord identity with a verified email may create a
# normal-user account. Default 0: only administrator-created users can sign in.
# RIVET_OAUTH_ALLOW_SIGNUP=0

# Behind a reverse proxy/tunnel on THIS host, name the header that carries the
# real client IP so rate limits apply per client instead of per proxy:
#   Caddy / nginx: X-Forwarded-For      Cloudflare (proxy or tunnel): CF-Connecting-IP
# Only honored for connections from loopback. Leave unset when clients connect directly.
# RIVET_PROXY_HEADER=CF-Connecting-IP

# Enable the Prometheus /metrics endpoint with a bearer secret (24+ chars).
# Leave unset to keep the endpoint disabled.
# RIVET_METRICS_TOKEN=replace-with-a-long-random-secret

# --- Static site hosting (off unless a listen address is set; see docs/sites.md)
# A separate listener that only serves hosted sites, never the panel. Route
# *.sites.example.com and verified custom domains to it in the reverse proxy.
# RIVET_SITES_LISTEN=127.0.0.1:8081
# RIVET_SITES_BASE_URL=https://sites.example.com
# RIVET_SITES_DIR=/var/lib/rivetpanel/sites
# RIVET_SITE_MAX_BYTES=104857600     # largest release, uncompressed
# RIVET_MAX_SITES_PER_USER=10        # 0 = unlimited; administrators are exempt
# RIVET_SITES_DNS_TARGET=            # CNAME target shown for custom domains

# --- SFTP (off unless a listen address is set; see docs/features.md) ---------
# SFTP is plain TCP: it does not pass through Cloudflare's HTTP proxy or a tunnel.
# RIVET_SFTP_LISTEN=0.0.0.0:2022
# RIVET_SFTP_MAX_FILE_BYTES=268435456
# RIVET_SFTP_HOST_KEY=/var/lib/rivetpanel/sftp_host_ed25519

# --- Published ports (bots opt in per bot; see docs/features.md) --------------
# Host ports bots may publish, and whether they may bind beyond 127.0.0.1.
# RIVET_PORT_RANGE=20000-29999
# RIVET_PORT_PUBLIC_BIND=0

# --- Per-bot backups ----------------------------------------------------------
# RIVET_BACKUP_DIR=/var/lib/rivetpanel/backups
# RIVET_BACKUP_INTERVAL=24h     # scheduled backups; 0 turns them off
# RIVET_BACKUP_KEEP=7           # scheduled backups kept per bot
# RIVET_BACKUP_MAX_BYTES=2147483648

# --- Capacity (admission checks; 0 = unlimited; see docs/features.md) ---------
# Sum of memory limits of bots wanted running on this host; a start that would
# exceed it is refused with an explanation. Not a kernel limit.
# RIVET_NODE_MEMORY_BYTES=0
# Per account (administrators are exempt):
# RIVET_USER_MEMORY_BYTES=0
# RIVET_MAX_BOTS_PER_USER=0
# Concurrent build containers (each can use the runtime's build memory, 3 GiB for Rust):
# RIVET_MAX_BUILDS=1
# Free space backups, restores and deployments need before they start:
# RIVET_MIN_FREE_DISK_BYTES=1073741824

# --- Email through Mailgun (optional; see docs/email.md) ----------------------
# Off until a key, domain and sender are set. Can also be set in Administration
# -> Panel settings (the key is then stored encrypted). Values set here win and
# show as read-only there. The key is a credential: keep this file mode 0640.
# RIVET_MAILGUN_API_KEY=
# RIVET_MAILGUN_DOMAIN=mg.example.com
# RIVET_MAILGUN_REGION=us          # us or eu: the region your Mailgun domain lives in
# RIVET_MAIL_FROM=RivetPanel <noreply@mg.example.com>

# --- AI operator -------------------------------------------------------------
# Configure encrypted provider and Risa/SearxNG credentials in Administration.
# Do not put provider keys in bot environments. Diagnostic jobs use the local
# Docker runner, an offline disposable container, and runtime YAML allowlists.
