[Unit]
Description=RivetPanel (Discord bot hosting panel)
Documentation=file:///usr/share/doc/rivetpanel/README.md
After=network-online.target docker.service
Wants=network-online.target
Wants=docker.service

[Service]
Type=simple
# The panel talks to the Docker socket, which is root-equivalent, and chowns
# bot workspaces to the container user, so it runs as root. The sandboxing
# below limits what a compromise of the panel process itself can reach; it does
# NOT isolate the Docker socket (only a separate runner process could).
User=root
EnvironmentFile=-/etc/rivetpanel/rivetpanel.env
ExecStart=/usr/local/bin/rivetpanel
Restart=on-failure
RestartSec=3
# Graceful shutdown finishes in-flight requests; bot containers keep running.
TimeoutStopSec=20

# Footprint: a soft Go heap ceiling (see docs/footprint.md). Not a hard cap.
Environment=GOMEMLIMIT=48MiB

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/rivetpanel
ReadOnlyPaths=/etc/rivetpanel
StateDirectory=rivetpanel
StateDirectoryMode=0750
# CAP_CHOWN/FOWNER/DAC_OVERRIDE: manage files owned by the container user.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
