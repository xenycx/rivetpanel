# Environment for the RivetPanel container (compose.yaml reads it as .env).
#
# The image already sets the listen address, the database, key, workspace and
# runtime paths so that everything lives in the /var/lib/rivetpanel volume.
# Do NOT copy deploy/systemd/rivetpanel.env.example here: its 127.0.0.1 listen
# address is unreachable through the published port and its /etc key directory
# is outside the volume, so keys would be lost with the container.
#
# Most variables can also be changed later from Administration -> Environment.

# The https origin users type in the browser (reverse proxy in front of the
# published 127.0.0.1:8080). OAuth callbacks and webhooks are derived from it.
# RIVET_PUBLIC_URL=https://panel.example.com

# Name the header that carries the real client IP when a reverse proxy runs on
# the same host (X-Forwarded-For for Caddy/nginx, CF-Connecting-IP for Cloudflare).
# RIVET_PROXY_HEADER=X-Forwarded-For

# Bot containers run as this uid:gid; workspaces are chowned to it.
# RIVET_CONTAINER_USER=65532:65532

# Optional listeners; also uncomment the matching ports in compose.yaml.
# RIVET_SFTP_LISTEN=0.0.0.0:2022
# RIVET_SITES_LISTEN=0.0.0.0:8081
# RIVET_SITES_BASE_URL=https://sites.example.com

# Remote nodes (preview; see docs/agents.md). Raw TLS, never through the proxy.
# RIVET_MODULES=agents=preview,game_servers=preview
# RIVET_AGENT_ADDRESS=panel.example.com:8444
# RIVET_AGENT_HOSTS=panel.example.com

# Other settings (OAuth clients, Mailgun, metrics, backups, capacity) use the
# same variables as deploy/systemd/rivetpanel.env.example, except the paths and
# RIVET_LISTEN, which the image sets.
